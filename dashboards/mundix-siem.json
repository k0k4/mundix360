        "rawSql": "SELECT\n  src_ip,\n  max(severity) AS max_severity,\n  count() AS alert_count,\n  groupUniqArray(rule_name) AS rules,\n  min(timestamp) AS first_seen,\n  max(timestamp) AS last_seen\nFROM akvorado.siem_alerts\nWHERE src_ip != '' AND timestamp > now() - INTERVAL 24 HOUR\nGROUP BY src_ip\nORDER BY max_severity DESC, alert_count DESC\nLIMIT 50",
