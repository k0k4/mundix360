# =============================================================================
# Mundix Security 360 — Manifesto de implantação (fonte única da verdade)
# Perfil: NÚCLEO (firewall + filtro de conteúdo + SIEM + IA remota)
#
# Este arquivo declara TUDO que o appliance precisa. É consumido tanto pelo
# build-bundle.sh (gera o pacote offline) quanto pelo install.sh (instala).
# Nada de hardcode espalhado: mude aqui e os dois lados acompanham.
# =============================================================================

MUNDIX_PROFILE="nucleo"
MUNDIX_VERSION="1.1.0"

# Sistema-base suportado (o instalador recusa fora disso).
TARGET_OS_ID="ubuntu"
TARGET_OS_VERSION="24.04"

# Onde o código vive (separado do estado em /etc/mundix e /var/lib).
MUNDIX_ROOT="/opt/mundix360"
MUNDIX_VENV="/opt/venv"

# -----------------------------------------------------------------------------
# Pacotes APT do perfil núcleo. Dependências transitivas são resolvidas pelo
# build-bundle.sh (download completo) — aqui ficam só os pacotes de topo.
# -----------------------------------------------------------------------------
APT_PACKAGES=(
  # Firewall / rede / DNS+DHCP / filtro de conteúdo
  nftables
  dnsmasq
  dnsmasq-base
  iproute2
  iputils-ping
  # Web / proxy reverso + WAF
  nginx
  libnginx-mod-http-modsecurity
  modsecurity-crs
  # IDS
  suricata
  suricata-update
  # VPN (WireGuard server/concentrator — fase 1)
  wireguard-tools
  qrencode
  # VPN (OpenVPN server + PKI — fase 2)
  openvpn
  easy-rsa
  # VPN (Fortinet SSL-VPN client — fase 3)
  openfortivpn
  # Runtime Python (a app roda no venv, mas precisa do interpretador base)
  python3
  python3-venv
  python3-pip
  # Utilitários operacionais
  curl
  ca-certificates
  openssl
  zstd
  jq
)

# Pacotes NÃO-CRÍTICOS (dados/SIEM): a falha de instalação deles NÃO pode
# abortar o instalador (ex.: ClickHouse >= 22.8 exige AVX — em CPU sem AVX o
# postinst morre com SIGILL, exit 132). Os instaladores os instalam depois da
# lista core, com falha => aviso + registro para o relatório final, nunca die.
# O build-bundle.sh continua baixando as DUAS listas (bundle completo).
APT_PACKAGES_NONCRIT=(
  clickhouse-server
  clickhouse-common-static
  valkey-server
)

# Pacotes que vêm de repositório de terceiros (precisam de setup no modo online;
# no modo offline já estão no bundle e isso é ignorado).
APT_THIRDPARTY_REPOS=(
  "clickhouse|https://packages.clickhouse.com/deb stable main|https://packages.clickhouse.com/rpm/lts/repodata/repomd.xml.key"
)

# -----------------------------------------------------------------------------
# Units systemd do Mundix (canônicas, já corrigidas para o perfil núcleo —
# sem dependência de vector/observabilidade). Vivem em installer/units/.
# -----------------------------------------------------------------------------
MUNDIX_UNITS=(
  mundix-dashboard-api.service
  mundix-active-response.service
  mundix-triage.service
  mundix-triage.timer
  mundix-siem-ingest.service
  mundix-suricata-update.service
  mundix-suricata-update.timer
)

# Units de distro que devem ficar habilitadas/ativas no appliance.
SYSTEM_UNITS_ENABLE=(
  nftables.service
  dnsmasq.service
  nginx.service
  suricata.service
  clickhouse-server.service
  valkey-server.service
  systemd-networkd.service
)

# Units que NÃO pertencem ao perfil núcleo — se existirem (ex.: imagem clonada),
# o instalador as desabilita para não competir por recursos no minipc.
PROFILE_DISABLE_UNITS=(
  akvorado-console.service akvorado-demo-exporter.service akvorado-inlet.service
  akvorado-orchestrator.service akvorado-outlet.service
  kafka.service loki.service vector.service victoriametrics.service
  grafana-server.service mundix-dashboard-build.service
)

# -----------------------------------------------------------------------------
# Árvore de estado/config criada no first-boot (vazia = identidade nova).
# -----------------------------------------------------------------------------
MUNDIX_STATE_DIRS=(
  /etc/mundix
  /var/lib/mundix
  "${MUNDIX_ROOT}/data/siem"
  "${MUNDIX_ROOT}/logs"
)

# Caminhos de config gerenciados (semeados a partir de installer/config/ se
# ainda não existirem no destino — nunca sobrescreve config do operador).
# Formato: "origem_no_repo::destino_no_sistema"
MUNDIX_CONFIG_SEED=(
  "configs/openrouter.env.example::${MUNDIX_ROOT}/configs/openrouter.env"
)
