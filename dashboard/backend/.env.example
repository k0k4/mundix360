# Mundix360 Dashboard API — environment
# Copie para .env e ajuste conforme necessário.

# API
MUNDIX_API_HOST=127.0.0.1
MUNDIX_API_PORT=8099
# Defina um token para exigir Authorization: Bearer <token>. Vazio = sem auth (apenas localhost).
MUNDIX_API_TOKEN=
MUNDIX_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# ClickHouse
MUNDIX_CLICKHOUSE_HOST=127.0.0.1
MUNDIX_CLICKHOUSE_PORT=8123
MUNDIX_CLICKHOUSE_DB=akvorado

# VictoriaMetrics / Loki
MUNDIX_VICTORIAMETRICS_URL=http://127.0.0.1:8428
MUNDIX_LOKI_URL=http://127.0.0.1:3100
